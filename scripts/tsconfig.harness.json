{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "electron": ["scripts/electron-shim.ts"]
    }
  },
  "include": ["./**/*.ts", "../src/main/**/*.ts", "../src/shared/**/*.ts"]
}
